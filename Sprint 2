# Import the tools needed for recording and speech recognition
import sounddevice as sd
from scipy.io.wavfile import write
from faster_whisper import WhisperModel
import subprocess
from datetime import datetime



# The recording settings
sample_rate = 16000
recording_time = 10


# Tell the user what question to say
print("Recording for 10 seconds...")
print("Please ask a travel-related question.")


# Record audio from the laptop microphone
recording = sd.rec(int(recording_time * sample_rate),samplerate=sample_rate,channels=1,dtype="int16")

# Wait until the recording is finished
sd.wait()


# Create a different filename using the current date and time
current_time = datetime.now().strftime("%Y%m%d_%H%M%S")
audio_file = f"travel_question_{current_time}.wav"

# Save the recording as a WAV file
write(audio_file, sample_rate, recording)

print("Recording finished.")
print("The question is now being transcribed...")


# Load the base Whisper model
# The CPU and int8 settings allow it to run without a graphics card
model = WhisperModel("base",device="cpu",compute_type="int8")


segments, information = model.transcribe(audio_file,language="en",beam_size=5,)


# Join the transcribed sections together into one sentence
transcribed_text = ""

for segment in segments:
    transcribed_text += segment.text.strip() + " "


# Display the final result
print("Detected language:", information.language)
print("Transcribed text:", transcribed_text.strip())

# Read the transcribed question aloud
if transcribed_text.strip():
    print("Reading the transcribed question aloud...")

    subprocess.run([
        "edge-playback",
        "--text",
        transcribed_text.strip(),
        "--voice",
        "en-AU-NatashaNeural"
    ])
else:
    print("No speech was detected, so there is nothing to read aloud.")
